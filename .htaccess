# Vlastní stránka pro neexistující adresy
ErrorDocument 404 /404.html

# Interní soubory nasazení nejsou veřejné
<FilesMatch "^(\.ftp-deploy-sync-state\.json|README\.md|.*\.txt)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<Files "robots.txt">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
  </IfModule>
</Files>
